<!DOCTYPE html>
<html>
<head>
<title>My Online Shop</title>

<style>
body{
    font-family: Arial;
    margin:0;
    background:#f4f4f4;
}

header{
    background:#222;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#ff6600;
    padding:10px;
    text-align:center;
}

nav a{
    color:white;
    margin:20px;
    text-decoration:none;
}

.container{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
}

.product{
    background:white;
    width:250px;
    margin:20px;
    padding:15px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px gray;
}

.product img{
    width:200px;
    height:150px;
}

button{
    background:#ff6600;
    color:white;
    border:none;
    padding:10px;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#cc5200;
}

.cart{
    text-align:center;
    padding:20px;
    font-size:20px;
}
</style>

</head>

<body>

<header>
<h1>My Online Shop</h1>
<p>Best Products At Best Price</p>
</header>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Contact</a>
</nav>


<div class="cart">
🛒 Cart Items: <span id="count">0</span>
</div>


<div class="container">

<div class="product">
<img src="https://via.placeholder.com/200">
<h2>Mobile Phone</h2>
<p>Price: ₹15000</p>
<button onclick="addCart()">Add To Cart</button>
</div>


<div class="product">
<img src="https://via.placeholder.com/200">
<h2>Laptop</h2>
<p>Price: ₹50000</p>
<button onclick="addCart()">Add To Cart</button>
</div>


<div class="product">
<img src="https://via.placeholder.com/200">
<h2>Headphone</h2>
<p>Price: ₹2000</p>
<button onclick="addCart()">Add To Cart</button>
</div>


</div>


<script>

let cart=0;

function addCart(){
cart++;
document.getElementById("count").innerHTML=cart;
alert("Product Added To Cart");
}

</script>


</body>
</html>
